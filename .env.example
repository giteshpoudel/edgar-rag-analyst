# Copy to .env and fill in. .env is gitignored.

# Required by the SEC: identify yourself with a name and contact email.
SEC_USER_AGENT="Your Name your@email.com"

# LLM: any OpenAI-compatible API with function calling works (change all three lines)
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Where downloaded filings and the vector index are stored
DATA_DIR=data

# Model that grades eval answers (defaults to LLM_MODEL). A different, stronger model judges more reliably.
JUDGE_MODEL=deepseek-v4-pro

# Retrieval (defaults chosen by the W2 ablation): vector | keyword | hybrid, and none | minilm | bge
RETRIEVAL_MODE=hybrid
RERANKER=none
